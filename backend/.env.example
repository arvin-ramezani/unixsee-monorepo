NODE_ENV=
PORT=
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted.
# Express walks the chain right-to-left this many hops to resolve request.ip, so
# per-IP rate limits count the address our own proxy observed. Use 0 when the app
# is exposed directly with no proxy.
# WARNING: setting this HIGHER than the real number of proxies re-opens IP
# spoofing - the extra hops are client-supplied, so a caller can forge a fresh
# rate-limit bucket per request with one header and nullify every per-IP ceiling.
TRUST_PROXY_HOPS=1
# To use with docker-compose
POSTGRES_DB= 
# To use with docker-compose
POSTGRES_USER= 
# To use with docker-compose
POSTGRES_PASSWORD= 

DATABASE_URL=postgresql://username:password@localhost:5432/database_name?schema=public
# Nest origin for agent install commands (no /api/v1 suffix)
AGENT_API_BASE_URL=https://core.unixsee.com
AGENT_ACTIVATION_TOKEN=uuid-token-for-agent-activation

SUPABASE_URL=https://abcdefghijk.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
SUPABASE_STORAGE_BUCKET=unixsee

# Storage provider: "filesystem" (local disk) or "s3" (Supabase S3)
STORAGE_PROVIDER=filesystem
LOCAL_STORAGE_PATH=./storage/uploads
# Public origin for browser-facing download URLs. Optional: defaults to
# http://localhost:PORT in development/test and AGENT_API_BASE_URL otherwise.
# STORAGE_PUBLIC_BASE_URL=http://localhost:4000

JWT_ACCESS_SECRET=jwt-access-secret-key-32-characters-long
JWT_REFRESH_SECRET=jwt-refresh-secret-key-32-characters-long
JWT_MONITORING_ACCESS_SECRET=jwt-monitoring-secret-key-32-characters-long
# 1m
# JWT_ACCESS_TOKEN_EXPIRATION=60 
# 1hour Integer value in seconds
JWT_ACCESS_TOKEN_EXPIRATION=3600
# 2hours Integer value in seconds
JWT_REFRESH_TOKEN_EXPIRATION=7200
# 15min Integer value in seconds
JWT_MONITORING_ACCESS_TOKEN_EXPIRATION=900
# minutes Integer value in minutes
OTP_EXPIRED_TIME_KEY=5 
# minutes Integer value in minutes
OTP_RETRY_TIME=2

# OTP abuse limits. All optional; these are the built-in defaults.
# Failed verification attempts allowed per issued code before it is dead.
OTP_MAX_VERIFY_ATTEMPTS=5
# Codes one phone/email may be issued per rolling window (enforced in the DB).
OTP_MAX_REQUESTS_PER_WINDOW=5
OTP_REQUEST_WINDOW_MINUTES=60
# Per-IP ceilings, enforced in-process by RateLimitGuard.
OTP_IP_REQUEST_LIMIT=10
OTP_IP_REQUEST_WINDOW_SECONDS=600
OTP_IP_VERIFY_LIMIT=20
OTP_IP_VERIFY_WINDOW_SECONDS=600
# Verification attempts aimed at one phone/email from any address.
OTP_TARGET_VERIFY_LIMIT=10
OTP_TARGET_VERIFY_WINDOW_SECONDS=600

# Uptime probe options are optional; these are defaults/recommended starting values.
UPTIME_PROBES_ENABLED=true
UPTIME_PROBE_CRON="* * * * *"
UPTIME_PROBE_STARTUP_DELAY_MS=5000
UPTIME_PROBE_TIMEOUT_MS=8000
UPTIME_PROBE_DNS_TIMEOUT_MS=3000
UPTIME_PROBE_IP_FAMILY=0
UPTIME_PROBE_DEBUG_LOGS=false
UPTIME_PROBE_CONCURRENCY=10
UPTIME_PROBE_BATCH_SIZE=100
UPTIME_PROBE_ALLOW_HTTP_FALLBACK=false
UPTIME_PROBE_ACCEPT_STATUS_CODES=200-399,401,403
UPTIME_PROBE_USER_AGENT=Unixsee-Uptime-Probe/1.0 (+https://unixsee.com)

# Ticket auto-close (customer RESOLVED → CLOSED grace). Allowed range 5–7 days.
TICKET_AUTO_CLOSE_ENABLED=true
TICKET_AUTO_CLOSE_GRACE_DAYS=7
TICKET_AUTO_CLOSE_CRON="0 * * * *"

# Temporary phone OTP delivery via SMTP (SMS stand-in until a real SMS provider).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
# Set false when SMTP has an expired/self-signed cert (local/dev only)
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM="Unixsee <no-reply@unixsee.com>"
PHONE_OTP_MOCK_DELIVERY_EMAIL=arvin.ramezani6@gmail.com
