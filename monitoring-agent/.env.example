NODE_ENV=production
API_BASE_URL=https://api.unixsee.com
ENROLLMENT_TOKEN=replace_with_one_time_enrollment_token
AGENT_SECRET=

OPENLITESPEED_SERVER_ROOT=/usr/local/lsws
OPENLITESPEED_VHOST_DECLARATION_PATHS=/usr/local/lsws/conf/httpd-vhosts.conf,/usr/local/lsws/conf/httpd_config.conf
OPENLITESPEED_LISTENER_PATHS=/usr/local/lsws/conf/listeners.conf,/usr/local/lsws/conf/httpd_config.conf
OPENLITESPEED_VHOSTS_ROOT=/usr/local/lsws/conf/vhosts
WEB_DISCOVERY_ROOTS=/var/www,/home
WEB_DISCOVERY_EXACT_PATHS=

# Active discovery defaults: listener map + vhost declaration + readable vhconf.conf.
# Keep false unless you intentionally want old/orphan vhost folders discovered.
OPENLITESPEED_DISCOVER_ORPHAN_VHOSTS=false

# Keep false on OpenLiteSpeed servers, otherwise filesystem folders can re-add stale domains.
# DirectAdmin owner/alias enrichment still runs when this is false.
WEB_DISCOVERY_INCLUDE_FALLBACKS=false

# Optional timing overrides (milliseconds)
# COLLECTION_INTERVAL_MS=10000
# TRANSMIT_INTERVAL_MS=60000
# HEARTBEAT_INTERVAL_MS=30000
# REDISCOVERY_INTERVAL_MS=600000
