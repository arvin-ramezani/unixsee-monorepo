NODE_ENV=production
API_BASE_URL=https://api.example.com
# One-time from admin reveal; removed after enroll persists AGENT_SECRET
# ENROLLMENT_TOKEN=
# AGENT_SECRET=

OPENLITESPEED_SERVER_ROOT=/usr/local/lsws
ACCESS_LOG_DIR=/var/log/httpd/domains
# DIRECTADMIN_BASE_URL=https://panel.example.com:2222

HEARTBEAT_INTERVAL_MS=30000
OLS_DISCOVERY_INTERVAL_MS=600000
STACK_PROBE_INTERVAL_MS=21600000
STACK_PROBE_CONCURRENCY=3
ACTIVE_VISITOR_WINDOW_SECONDS=180
ACTIVE_VISITOR_SAMPLE_INTERVAL_MS=30000
VISITORS_24H_SAMPLE_INTERVAL_MS=300000
# Legacy alias accepted temporarily: TRAFFIC_WINDOW_SECONDS=180
TRAFFIC_INITIAL_READ_MAX_BYTES=1048576
TRAFFIC_RECONCILE_INTERVAL_MS=15000
# Installer-owned protected local OLS/PHP runtime probe.
# The agent always connects to 127.0.0.1 and the fixed
# /.well-known/unixsee/runtime.php path; only port/secret are local configuration.
# RUNTIME_PROBE_SECRET=replace-with-installer-generated-secret
RUNTIME_PROBE_PORT=80
RUNTIME_PROBE_TIMEOUT_MS=5000

