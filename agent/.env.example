NODE_ENV=production
API_BASE_URL=https://api.example.com
# One-time installer input. The installer removes it after enrollment.
# ENROLLMENT_TOKEN=

AGENT_STATE_DIR=/opt/unixsee-agent/state
OPENLITESPEED_SERVER_ROOT=/usr/local/lsws
OLS_ROUTING_FILES=/usr/local/lsws/conf/httpd_config.conf
ACCESS_LOG_DIR=/var/log/httpd/domains
PROBE_SCHEME=https
PROBE_PORT=443
PROBE_PATH=/.unixsee/v1/site-stack.php
PROBE_SECRET=installer-generated
PROBE_TIMEOUT_MS=5000
PROBE_CONCURRENCY=3

HEARTBEAT_INTERVAL_MS=30000
TRAFFIC_POLL_INTERVAL_MS=1000
ACTIVE_VISITORS_INTERVAL_MS=30000
VISITORS_24H_INTERVAL_MS=300000
DISCOVERY_INTERVAL_MS=600000
STACK_INTERVAL_MS=21600000
MAX_INITIAL_LOG_BYTES=4194304
