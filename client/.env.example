#--- Server Variables
UNIXSEE_API_KEY=uxc_6ZjuWGio2dJX4mlukeWf5UukWfYECLfbmVyYFyGnFwX0MloU

UNIXSEE_WP_API_BASE_URL=http://localhost:3000/api/mock/unixsee/v1/
UNIXSEE_CORE_API_BASE_URL=http://localhost:4000/api/v1
PORT=3001

# Auth cookie names (optional; defaults shown)
ACCESS_TOKEN_COOKIE_NAME=unixsee_access_token
REFRESH_TOKEN_COOKIE_NAME=unixsee_refresh_token
SERVER_CLOCK_OFFSET_COOKIE_NAME=unixsee_server_clock_offset
PHONE_NUMBER_TO_LOGIN_KEY=unixsee_pending_login_phone

#--- Client Variables
NEXT_PUBLIC_NODE_ENV=production
NEXT_PUBLIC_UNIXSEE_CORE_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_PORT=3001

# Email
# Email — use one SMTP host only (Next keeps the first EMAIL_SMTP_HOST value).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
# Set to false when the SMTP host has an expired/self-signed cert (local dev only)
EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

EMAIL_FROM="Unixsee <no-reply@unixsee.com>"
EMAIL_ADMIN_TO=
EMAIL_ADMIN_LOCALE=fa



